[Plugin]
name = sxsy13 论坛自动签到
desc = 自动抓取sxsy13论坛Cookie并执行每日带算术题的签到
author = zygz

[Script]
# 1. 抓包保存 Cookie
http-request ^https?:\/\/www\.sxsy13\.com\/plugin\.php\?id=k_misign:sign script-path=https://raw.githubusercontent.com/liuxianlke/zygz/main/loonplugin/sxsy/sxsy13.js, requires-body=false, tag=sxsy13获取Cookie

# 2. 每日自动签到定时任务 (每天早上 8:30)
cron "30 8 * * *" script-path=https://raw.githubusercontent.com/liuxianlke/zygz/main/loonplugin/sxsy/sxsy13.js, tag=sxsy13每日签到

[Mitm]
hostname = www.sxsy13.com
