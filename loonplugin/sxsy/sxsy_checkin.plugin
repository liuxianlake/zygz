#!name = sxsy自动签到
#!desc = sxsy 论坛自动签到（k_misign 数学题自动计算）。域名会变：换域名只需修改「站点域名」参数，无需改代码
#!author = liuxianlake
#!homepage = https://github.com/liuxianlake/zygz
#!icon = https://cloudflare-imgbed-6gi.pages.dev/file/icon/1786667308789_photo_2025-02-22_19-18-22.jpg
#!tag = 签到
#!system = iOS,iPadOS,macOS
#!loon_version = 3.5.1(983)
#!type = normal

[Argument]
site_host = input,"sxsy45.com",tag=站点域名,desc=当前论坛域名（数字经常变，如 sxsy46.com），只填域名，不要带 https://
cron_expr = input,"0 8 * * *",tag=定时时间,desc=Cron 表达式（分 时 日 月 周），默认每天 8:00

[General]

[Rewrite]

[Host]

[Script]
# 1. 浏览论坛时自动捕获/刷新 Cookie（域名变化后重新登录一次即可自动更新）
request if ${url} ~= ${site_host} then script("https://raw.githubusercontent.com/liuxianlake/zygz/main/loonplugin/sxsy/sxsy-cookie.js") with tag="sxsy Cookie捕获", timeout=10
# 2. 定时自动签到（自动完成：formhash → 数学题 → 提交）
cron ${cron_expr} then script("https://raw.githubusercontent.com/liuxianlake/zygz/main/loonplugin/sxsy/sxsy_checkin.js", {${site_host}}) with tag="sxsy自动签到", timeout=60
# 3. 手动签到（测试用）
generic then script("https://raw.githubusercontent.com/liuxianlake/zygz/main/loonplugin/sxsy/sxsy_checkin.js", {${site_host}}) with tag="sxsy手动签到", timeout=60, img_url="checkmark.circle"

[Mitm]
hostname = sxsy*.com, *.sxsy*.com
