[Plugin]
name = sxsy13 论坛自动签到
desc = 自动抓取sxsy13论坛Cookie并执行每日带算术题的签到
author = zygz
icon = https://raw.githubusercontent.com/google/material-design-icons/master/png/social/group/materialiconspins/48dp/1x/baseline_group_black_48dp.png

[Script]
# 1. 抓包保存 Cookie (当你在 Safari 访问论坛签到页面时自动触发)
http-request ^https?:\/\/www\.sxsy13\.com\/plugin\.php\?id=k_misign:sign script-path=https://raw.githubusercontent.com/liuxianlake/zygz/refs/heads/main/loonplugin/%E5%B0%9A%E9%A6%99%E4%B9%A6%E9%99%A2/sxsy13.js, requires-body=false, tag=sxsy13获取Cookie

# 2. 每日自动签到定时任务 (每天早上 8:30 自动运行)
cron "30 8 * * *" script-path=https://raw.githubusercontent.com/liuxianlake/zygz/main/sxsy13.js, tag=sxsy13每日签到

[Mitm]
hostname = www.sxsy13.com
