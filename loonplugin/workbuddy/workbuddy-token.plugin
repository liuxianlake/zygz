#!name = WorkBuddy 登录态捕获
#!desc = 手机端使用 WorkBuddy 时自动捕获请求头里的 accessToken 与 X-User-Id，存入 Loon 本地存储。只记录长度不打印令牌内容，不修改任何请求。配合「WorkBuddy 自动签到」使用，无需手工粘贴 token，登录态刷新后也会自动同步
#!author = liuxianlake
#!homepage = https://github.com/liuxianlake/zygz
#!icon = https://cdn.jsdelivr.net/gh/liuxianlake/zygz@main/loonplugin/workbuddy/icon.png
#!tag = 工具
#!system = iOS,iPadOS,macOS
#!loon_version = 3.5.1(983)
#!type = normal

[General]

[Rewrite]

[Host]

[Script]
# 捕获 workbuddy / codebuddy / copilot.tencent 域名请求中的登录态
# 手机 App 走 copilot.tencent.com，PC 客户端走 www.workbuddy.cn，两套网关都覆盖
request if ${url} ~= /^https?:\/\/[^\/]*(?:workbuddy|codebuddy|copilot\.tencent)[^\/]*/i then script("https://raw.githubusercontent.com/liuxianlake/zygz/main/loonplugin/workbuddy/workbuddy-token.js?v=20261128a") with tag="WorkBuddy登录态捕获", timeout=10

[Mitm]
hostname = %APPEND% *.workbuddy.cn, workbuddy.cn, *.workbuddy.ai, workbuddy.ai, *.codebuddy.cn, codebuddy.cn, *.codebuddy.ai, codebuddy.ai, copilot.tencent.com
