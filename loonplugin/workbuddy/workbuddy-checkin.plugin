#!name = WorkBuddy 自动签到
#!desc = 自动捕获登录态 + 每日 7:00 自动领取 WorkBuddy 签到积分（100 分/天），失败在 11/15/19/23 点自动重试。登录态从手机 App 流量中自动获取并持续刷新，本插件不自行刷新令牌，因此不会与 PC 客户端争用登录态；签到接口幂等，当天确认完成后不再重复请求
#!author = liuxianlake
#!homepage = https://github.com/liuxianlake/zygz
#!icon = https://raw.githubusercontent.com/liuxianlake/zygz/main/loonplugin/workbuddy/icon.png
#!tag = 签到
#!system = iOS,iPadOS,macOS
#!loon_version = 3.5.1(983)
#!type = normal

[Argument]
cron_expr = input,"0 7,11,15,19,23 * * *",tag=定时时间,desc=Cron 表达式（分 时 日 月 周）。默认 7 点签，失败时 11/15/19/23 点自动重试；已签到会直接跳过，不会重复领取。只填一个时间可去掉后面的时段，如 0 7 * * *
notify_when_signed = switch,false,tag=已签到也通知,desc=关（默认）：今天已签过则不打扰；开：每次执行都提示一句

[General]

[Rewrite]

[Host]

[Script]
# 1. 登录态捕获：手机 App 使用过程中自动更新 token（手机走 copilot.tencent.com，PC/H5 走 workbuddy.cn）
request if ${url} ~= /^https?:\/\/[^\/]*(?:workbuddy|codebuddy|copilot\.tencent)[^\/]*/i then script("https://raw.githubusercontent.com/liuxianlake/zygz/main/loonplugin/workbuddy/workbuddy-token.js?v=20261121b") with tag="WorkBuddy登录态捕获", timeout=10
# 2. 定时签到：网关择优 → 查状态 → 已签跳过 / 未签则签，失败由后续时点自动重试
cron ${cron_expr} then script("https://raw.githubusercontent.com/liuxianlake/zygz/main/loonplugin/workbuddy/workbuddy-checkin.js?v=20261121d", {${notify_when_signed}}) with tag="WorkBuddy自动签到", timeout=60
# 3. 手动跑一次（测试用）
generic then script("https://raw.githubusercontent.com/liuxianlake/zygz/main/loonplugin/workbuddy/workbuddy-checkin.js?v=20261121d", {${notify_when_signed}}) with tag="WorkBuddy手动签到", timeout=60, img_url="checkmark.circle"

[Mitm]
hostname = %APPEND% *.workbuddy.cn, workbuddy.cn, *.workbuddy.ai, workbuddy.ai, *.codebuddy.cn, codebuddy.cn, *.codebuddy.ai, codebuddy.ai, copilot.tencent.com
