#!name = WorkBuddy 自动签到
#!desc = 每日自动领取 WorkBuddy 签到积分（100 分/天）。登录态由「WorkBuddy 登录态捕获」插件从手机 App 流量中自动获取并持续刷新，本插件不自行刷新令牌，因此不会与 PC 客户端争用登录态。签到接口幂等，重复执行不会重复领取
#!author = liuxianlake
#!homepage = https://github.com/liuxianlake/zygz
#!tag = 签到
#!system = iOS,iPadOS,macOS
#!loon_version = 3.5.1(983)
#!type = normal

[Argument]
cron_expr = input,"20 8 * * *",tag=定时时间,desc=Cron 表达式（分 时 日 月 周），默认每天 8:20 自动签到
notify_when_signed = switch,false,tag=已签到也通知,desc=关（默认）：今天已签过则不打扰；开：每次执行都提示一句

[General]

[Rewrite]

[Host]

[Script]
# 定时自动签到（网关择优 → 查状态 → 未签则签）
cron ${cron_expr} then script("https://raw.githubusercontent.com/liuxianlake/zygz/main/loonplugin/workbuddy/workbuddy-checkin.js", {${notify_when_signed}}) with tag="WorkBuddy自动签到", timeout=60
# 手动跑一次（测试用）
generic then script("https://raw.githubusercontent.com/liuxianlake/zygz/main/loonplugin/workbuddy/workbuddy-checkin.js", {${notify_when_signed}}) with tag="WorkBuddy手动签到", timeout=60, img_url="checkmark.circle"
